{
  "name": "panzerpat",
  "version": "1.0.0",
  "description": "A bouncy tank-petting idle game",
  "main": "dist-electron/main.js",
  "author": "PanzerPat",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json && tsc -p tsconfig.electron.json && vite build && electron-builder --win portable --x64 --publish never",
    "build:web": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.panzerpat.game",
    "productName": "PanzerPat",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "signAndEditExecutable": false },
    "portable": { "artifactName": "PanzerPat-Windows.exe" }
  }
}
